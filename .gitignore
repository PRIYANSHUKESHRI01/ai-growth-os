# ──────────────────────────────────────────────────────────────────────────────
# AI Growth OS — Production .gitignore
# ──────────────────────────────────────────────────────────────────────────────

# ── Environment / Secrets ──────────────────────────────────────────────────────
.env
.env.*
!.env.example
.env.local
.env.*.local

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python

# Build artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg
sdist/
wheels/
*.whl

# Virtual environments
venv/
env/
.venv/
ENV/
.env_backup/

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover
*.coveragerc

# ── ML Models (persisted via Docker volume, not git) ─────────────────────────
**/app/ml/models/*.pkl
**/app/ml/models/*.joblib
**/app/ml/models/*.h5
**/app/ml/models/*.pt
**/app/ml/models/*.bin

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
*.log.*
celery*.log
gunicorn*.log

# ── Node.js / Next.js ─────────────────────────────────────────────────────────
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp
.pnp.*

# Next.js build outputs
.next/
out/
/build

# TypeScript
*.tsbuildinfo
next-env.d.ts

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace
.fleet/
.cursor/

# ── Docker ────────────────────────────────────────────────────────────────────
.docker/

# ── Vercel ────────────────────────────────────────────────────────────────────
.vercel

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Temporary / Local artifacts ───────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.backup
*.orig
*.swp
pip_out.txt
local_test_*

# ── Archive (cleanup utilities, not runtime) ─────────────────────────────────
backend/archive/
frontend/archive/
