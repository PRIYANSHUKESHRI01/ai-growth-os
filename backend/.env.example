# ─── Application ────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-32char-secret

# ─── Database ────────────────────────────────────────────────────
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_growth_os

# ─── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── OpenAI ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ─── SendGrid ────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=AI Growth OS

# ─── Email Rate Limiting ─────────────────────────────────────────
# Max emails per minute per user (to avoid SendGrid limits)
EMAIL_RATE_LIMIT_PER_MINUTE=10
# Max emails per day per user
EMAIL_RATE_LIMIT_PER_DAY=500

# ─── CORS ────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
